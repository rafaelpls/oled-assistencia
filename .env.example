# Local: postgresql://oled:SENHA@localhost:5432/oled?schema=public
# Supabase: connection string do TRANSACTION POOLER (porta 6543, com ?pgbouncer=true)
DATABASE_URL=postgresql://oled:CHANGE_DATABASE_PASSWORD@localhost:5432/oled?schema=public
# Usada pelo Prisma para migrations; local = igual à DATABASE_URL; Supabase = connection string direta (porta 5432, host db.<ref>.supabase.co)
DIRECT_URL=postgresql://oled:CHANGE_DATABASE_PASSWORD@localhost:5432/oled?schema=public
POSTGRES_DB=oled
POSTGRES_USER=oled
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PIN_ENCRYPTION_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
ADMIN_EMAIL=admin.oled@gmail.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=SET_INITIAL_PASSWORD_HERE
FRONTEND_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=4000
# "local" (padrão, usa UPLOAD_DIR) ou "supabase" (Supabase Storage)
PHOTO_STORAGE=local
UPLOAD_DIR=uploads
# URL do projeto Supabase (ex.: https://<ref>.supabase.co); usada apenas se PHOTO_STORAGE=supabase
SUPABASE_URL=
# Chave service role (segredo de servidor — NUNCA expor no frontend); usada apenas se PHOTO_STORAGE=supabase
SUPABASE_SERVICE_ROLE_KEY=
# Bucket PRIVADO onde as fotos das OS são gravadas
SUPABASE_STORAGE_BUCKET=os-photos
SWAGGER_ENABLED=false
TRUST_PROXY=false
NODE_ENV=development
