{
  "name": "oled-assistencia",
  "private": true,
  "scripts": {
    "dev:api": "tsc -p backend/tsconfig.json && node dist/backend/src/main.js",
    "dev:web": "next dev frontend --hostname 127.0.0.1",
    "build": "npm run build:api && next build frontend --webpack",
    "build:cloudflare": "cross-env CLOUDFLARE_STATIC_EXPORT=true next build frontend --webpack",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "test": "npm run build:api && node --test backend/tests/*.test.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/backend/prisma/seed.js",
    "build:api": "prisma generate && tsc -p backend/tsconfig.json",
    "lint:web": "eslint frontend",
    "typecheck:web": "tsc -p frontend/tsconfig.json --noEmit --incremental false",
    "test:web": "node frontend/tests/browser.cjs"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "multer": "2.4.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.1.0"
  },
  "overrides": {
    "multer": "$multer",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.20.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.0.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.0.0"
  }
}
